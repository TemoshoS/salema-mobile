{
  "expo": {
    "name": "Salema",
    "slug": "salema-mobile",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon copy.png",
    "scheme": "salemamobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.maduane.salema",
      "buildNumber": "1",
      "icon": "./assets/images/icon copy.png",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Salema uses your location to send your live GPS position to your trusted contacts during an emergency SOS.",
        "NSMicrophoneUsageDescription": "Salema needs access to your microphone to enable voice commands for emergency alerts.",
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.maduane.salema",
      "googleServicesFile": "./google-services.json",
      "versionCode": 2,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBW2I1gsUDE__pkSV6h4YYmskxnWgR5y-E"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icon copy.png",
        "monochromeImage": "./assets/images/icon copy.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyBW2I1gsUDE__pkSV6h4YYmskxnWgR5y-E",
          "iosGoogleMapsApiKey": "AIzaSyBW2I1gsUDE__pkSV6h4YYmskxnWgR5y-E"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Salema needs access to your location to send your live GPS position to your trusted contacts during an emergency."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Salema needs access to your microphone to enable voice commands for emergency alerts."
        }
      ],
      "expo-image",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8ca255f2-54ad-4748-b885-f20536f96ce0"
      }
    }
  }
}
